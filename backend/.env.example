# ContentFlow AI Backend Environment Configuration
PROJECT_NAME="ContentFlow AI"
ENVIRONMENT="development" # Set to "production" in Render
PORT=8000
HOST="0.0.0.0"

# Database Configuration
# 1. Local Dev: SQLite file
DATABASE_URL="sqlite:///./contentflow.db"
# 2. Render Persistent Disk (Starter plan, mounted at /var/data):
# DATABASE_URL="sqlite:////var/data/contentflow.db"
# 3. Render Managed PostgreSQL / Supabase / Neon:
# DATABASE_URL="postgresql://user:password@host:5432/dbname"

# AI Provider Configuration
# Options: "gemini" | "demo" | "openai"
# (Both LLM_PROVIDER and AI_PROVIDER are supported)
LLM_PROVIDER="demo"
AI_PROVIDER="gemini"

# Google Gemini API Configuration (Official google-genai Python SDK)
# Obtain an API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Optional Alternative Providers
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-3-5-sonnet-20241022"

# Google Sheets Integration (Service Account Path)
GOOGLE_SERVICE_ACCOUNT_JSON=""

# CORS Frontend Whitelist
# Set FRONTEND_URL to your deployed Vercel domain, e.g. "https://contentflow-ai.vercel.app"
# Multiple origins can be comma-separated: "https://contentflow-ai.vercel.app,http://localhost:5173"
FRONTEND_ORIGIN="http://localhost:5173"
FRONTEND_URL=""
ALLOWED_ORIGINS=""
