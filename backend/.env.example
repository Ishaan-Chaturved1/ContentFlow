# ContentFlow AI Environment Configuration
PROJECT_NAME="ContentFlow AI"
ENVIRONMENT="development"
PORT=8000
HOST="0.0.0.0"

# Database Configuration
DATABASE_URL="sqlite:///./contentflow.db"

# LLM Provider Configuration
# Options: "gemini" | "demo" | "openai"
# - Set to "demo" for the labelled realistic luxury sample strategy (no API key required).
# - Set to "gemini" for live generation with Google Gemini using the official google-genai SDK.
LLM_PROVIDER="demo"

# Google Gemini API Configuration (Official google-genai Python SDK)
# Obtain an API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Optional Alternative Providers
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-3-5-sonnet-20241022"

# Google Sheets Integration (Service Account Path)
GOOGLE_SERVICE_ACCOUNT_JSON=""

# Frontend Origin for CORS
FRONTEND_ORIGIN="http://localhost:5173"
